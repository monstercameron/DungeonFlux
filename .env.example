# Server and build-time vendor credentials. Keep real values in a local .env.
# OpenAI LLM, image, and speech credentials
DF_OPENAI_API_KEY=
# Gemini prerender credentials
DF_GEMINI_API_KEY=
# Anthropic fallback credentials
DF_ANTHROPIC_API_KEY=
# ElevenLabs STT, TTS, music, and sound credentials
DF_ELEVENLABS_API_KEY=
# Segmind video credentials
DF_SEGMIND_API_KEY=
# EvoLink video fallback credentials
DF_EVOLINK_API_KEY=
# fal video fallback credentials
DF_FAL_KEY=
# Cerebras experiment credentials
DF_CEREBRAS_API_KEY=
# TypeSafe experiment credentials
DF_TYPESAFE_API_KEY=
# World Labs build-time splat credentials
DF_WORLDLABS_API_KEY=
# Optional World Labs endpoint override
DF_WORLDLABS_URL=
# Debug CLI token when server.debug is enabled
DF_DEBUG_TOKEN=
# Set to 1 only for live-tagged tests
DF_LIVE=
# Audio fixture path for the live STT probe
DF_LIVE_STT_AUDIO_FILE=
# ElevenLabs voice ID for the live probe
DF_PROBE_VOICE_ID=
# Optional LLM probe model override
DF_PROBE_LLM_MODEL=
# Optional LLM probe endpoint override
DF_PROBE_LLM_URL=
# Optional TTS probe endpoint override
DF_PROBE_TTS_URL=
# Optional STT probe endpoint override
DF_PROBE_STT_URL=
# Optional OpenAI Images endpoint override
DF_OPENAI_IMAGES_URL=
# Optional Segmind video endpoint override
DF_SEGMIND_VIDEO_URL=

# All generated output lives under artifacts/ (see AGENTS.md section 4).
artifacts/*
!artifacts/.gitkeep

# Runtime data if a stray run writes outside artifacts/
*.db
*.db-wal
*.db-shm
*.db-journal
*.sqlite
*.sqlite3

# Secrets
.env
.env.*
!.env.example

# Go build and test output
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.wasm
*.wasm.br
*.wasm.gz
*.prof
*.pprof
*.cov
*.coverprofile
coverage.html
cover.html

# Logs and temp files
*.log
*.tmp
*.swp
*~

# Tooling
node_modules/
__pycache__/
*.pyc
.venv/
.claude/settings.local.json

# OS and editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
